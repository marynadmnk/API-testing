    {
      "name": "GET lists",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const body = pm.response.json();",
              "",
              "pm.test(\"Response contains lists array\", function () {",
              "    pm.expect(body.lists).to.be.an(\"array\");",
              "});",
              "",
              "pm.test(\"Lists array is not empty\", function () {",
              "    pm.expect(body.lists.length).to.be.greaterThan(0);",
              "});",
              "",
              "pm.test(\"List has required fields\", function () {",
              "    const list = body.lists[0];",
              "",
              "    pm.expect(list).to.have.property(\"id\");",
              "    pm.expect(list).to.have.property(\"name\");",
              "    pm.expect(list).to.have.property(\"orderindex\");",
              "});",
              "",
              "const schema = {",
              "    type: \"object\",",
              "    required: [\"lists\"],",
              "    properties: {",
              "        lists: {",
              "            type: \"array\",",
              "            items: {",
              "                type: \"object\",",
              "                required: [\"id\", \"name\", \"orderindex\"],",
              "                properties: {",
              "                    id:               { type: \"string\" },",
              "                    name:             { type: \"string\" },",
              "                    orderindex:       { type: \"number\" },",
              "                    content:          { type: \"string\" },",
              "                    status:           {},",
              "                    priority:         {},",
              "                    assignee:         {},",
              "                    task_count:       { type: \"number\" },",
              "                    due_date:         {},",
              "                    start_date:       {},",
              "                    archived:         { type: \"boolean\" },",
              "                    override_statuses:{ type: \"boolean\" },",
              "                    permission_level: { type: \"string\" },",
              "                    folder: {",
              "                        type: \"object\",",
              "                        properties: {",
              "                            id:       { type: \"string\" },",
              "                            name:     { type: \"string\" },",
              "                            hidden:   { type: \"boolean\" },",
              "                            archived: { type: \"boolean\" },",
              "                            access:   { type: \"boolean\" }",
              "                        }",
              "                    },",
              "                    space: {",
              "                        type: \"object\",",
              "                        properties: {",
              "                            id:       { type: \"string\" },",
              "                            name:     { type: \"string\" },",
              "                            archived: { type: \"boolean\" },",
              "                            access:   { type: \"boolean\" }",
              "                        }",
              "                    }",
              "                }",
              "            }",
              "        }",
              "    }",
              "};",
              "",
              "pm.test(\"Schema is valid\", function () {",
              "    pm.response.to.have.jsonSchema(schema);",
              "});",
              "",
              "const ids = body.lists.map(list => list.id);",
              "",
              "console.log(\"All List IDs:\");",
              "ids.forEach(id => console.log(id));"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
