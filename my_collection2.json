    {
      "name": "CREATE list",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Your test name\", function () {",
              "    var body = pm.response.json();",
              "    pm.expect(body.priority).to.eql(null);",
              "});",
              "var body = pm.response.json();",
              "",
              "console.log(body);",
              "console.log(body.id);",
              "",
              "pm.collectionVariables.set(\"list_id\", body.id);",
              "",
              "pm.test(\"List contains required fields\", function () {",
              "    pm.expect(body).to.have.property(\"id\");",
              "    pm.expect(body).to.have.property(\"name\");",
              "    pm.expect(body).to.have.property(\"folder\");",
              "});",
              "",
              "pm.test(\"Response schema validation\", function () {",
              "    const schema = {",
              "        type: \"object\",",
              "        required: [\"id\", \"name\"]",
              "    };",
              "",
              "    const Ajv = require('ajv');",
              "    const ajv = new Ajv();",
              "    const valid = ajv.validate(schema, pm.response.json());",
              "    pm.expect(valid).to.be.true;",
              "});",
              "",
              "pm.test(\"Schema validation\", () => {",
              "    const schema = {",
              "        type: \"object\",",
              "        required: [\"id\", \"name\"]",
              "    };",
              "",
              "    const Ajv = require('ajv');",
              "    const ajv = new Ajv();",
              "    const valid = ajv.validate(schema, pm.response.json());",
              "",
              "    pm.expect(valid).to.be.true;",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "pm.sendRequest({\r",
              "    url: \"https://api.clickup.com/api/v2/list/{{list_id}}/task\",\r",
              "    method: \"POST\",\r",
              "    header: {\r",
              "        \"Authorization\": pm.environment.get(\"token\"),\r",
              "        \"Content-Type\": \"application/json\"\r",
              "    },\r",
              "    body: {\r",
              "        mode: \"raw\",\r",
              "        raw: JSON.stringify({\r",
              "            name: \"Task created in pre-request\"\r",
              "        })\r",
              "    }\r",
              "}, function (err, res) {\r",
              "\r",
              "    if (!err) {\r",
              "        const taskId = res.json().id;\r",
              "\r",
              "        pm.environment.set(\"temp_task_id\", taskId);\r",
              "\r",
              "        console.log(\"Created task:\", taskId);\r",
              "    }\r",
              "});"
