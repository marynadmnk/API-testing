              "});\r",
              "\r",
              "const body = pm.response.json();\r",
              "\r",
              "pm.test(\"Response contains lists array\", function () {\r",
              "    pm.expect(body.lists).to.be.an(\"array\");\r",
              "});\r",
              "\r",
              "pm.test(\"Lists array is not empty\", function () {\r",
              "    pm.expect(body.lists.length).to.be.greaterThan(0);\r",
