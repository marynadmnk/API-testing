      "name": "GET list",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "const body = pm.response.json();\r",
              "\r",
              "pm.test(\"Response contains list ID\", function () {\r",
              "    pm.expect(body).to.have.property(\"id\");\r",
              "});\r",
              "\r",
              "pm.test(\"Returned list ID matches request list ID\", function () {\r",
              "    pm.expect(body.id.toString())\r",
              "        .to.eql(pm.collectionVariables.get(\"list_id\"));\r",
              "});\r",
              "\r",
              "pm.test(\"List contains required fields\", function () {\r",
              "    pm.expect(body).to.have.property(\"id\");\r",
              "    pm.expect(body).to.have.property(\"name\");\r",
              "    pm.expect(body).to.have.property(\"folder\");\r",
              "    pm.expect(body).to.have.property(\"space\");\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
